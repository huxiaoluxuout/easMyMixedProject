{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "adhoc": {
      "distribution": "internal",
      "credentialsSource": "local",
      "developmentClient": true,
      "ios": {
        "provisioningProfile": "latest"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "provisioningProfile": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },

    "production-splits": {
      "android": {
        "buildType": "apk",
        "env": {
          "ENABLE_ABI_SPLITS": "true"
        }
      },
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {}
  }
}
